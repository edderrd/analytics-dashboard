# Relay analytics dashboard — Docker Compose configuration
#
# Copy to `.env` in the repository root to override the defaults:
#     cp .env.example .env
#
# This file is OPTIONAL. Compose substitutes the defaults below, so
# `docker compose up --build` works on a fresh clone with no `.env` present.
# Each `:-default` means "use this when the variable is unset or empty".

# --- Database --------------------------------------------------------------
# The `db` service and the `backend` service both read these, so the app can
# never end up pointed at a different database than the one Compose created.
DATABASE_USER=relay
DATABASE_PASSWORD=relay
DATABASE_NAME=relay
# Host as seen from your machine. Inside the Compose network the backend always
# reaches the database at the service name below, whatever this is set to.
DATABASE_HOST=localhost
# Host port published for the database.
DATABASE_PORT=5432

# --- Published ports -------------------------------------------------------
# Host port for the API. Change it if 3000 is already in use locally.
BACKEND_PORT=3000
# Host port for the dashboard.
FRONTEND_PORT=5173