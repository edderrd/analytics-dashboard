# Relay analytics dashboard — backend configuration
#
# Copy to `.env` to override the defaults:
#     cp .env.example .env
#
# This file is OPTIONAL. Every variable below already has a working default, so
# a fresh clone runs with no `.env` at all:
#
#     docker compose up --build
#
# A `.env` here is only read when the variable is not already set, so Compose
# and shell values always win. Values are validated at startup: an invalid
# value fails immediately with a message naming the variable, rather than
# surfacing later as a confusing connection error.

# --- Runtime ---------------------------------------------------------------
# One of: development | production | test
NODE_ENV=development
# Port the API listens on. Must be an integer between 1 and 65535.
PORT=3000

# --- Database --------------------------------------------------------------
# Matches the `db` service in docker-compose.yml. Inside Compose this is
# overridden to the service name (`db`); the default is for running the backend
# directly on your machine.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=relay
DATABASE_PASSWORD=relay
DATABASE_NAME=relay

# Database used by the integration tests. It is dropped, migrated and re-seeded
# on every run, so it must never be the database holding the dataset from
# `seed.sql`.
TEST_DATABASE_NAME=relay_test

# --- Frontend dev server ---------------------------------------------------
# Where `npm run dev` proxies `/api` requests.
VITE_PROXY_TARGET=http://localhost:3000